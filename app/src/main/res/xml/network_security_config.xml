<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is HTTPS, except AviationStack's free plan, which only answers plain http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">api.aviationstack.com</domain>
    </domain-config>
</network-security-config>
